{
  "language": "ru",
  "max_model": "opus",
  "tiers": {
    "search": { "model": "haiku" },
    "mechanical": { "model": "sonnet", "effort": "medium" },
    "ordinary": { "model": "opus", "effort": "medium" },
    "risky": { "model": "opus", "effort": "high" },
    "deep": { "model": "opus", "effort": "xhigh" }
  },
  "rules": [
    { "name": "wt-keeper keeps haiku", "match": { "type": "ios-team:wt-keeper" }, "abstain": true },
    { "name": "publisher keeps sonnet medium", "match": { "type": "ios-team:publisher" }, "abstain": true },
    { "name": "qa-tester: sonnet medium always", "match": { "type": "ios-team:qa-tester" }, "model": "sonnet", "effort": "medium" },
    { "name": "reviewer: sonnet medium always", "match": { "type": "ios-team:reviewer" }, "model": "sonnet", "effort": "medium" },
    { "name": "analytics: sonnet medium always", "match": { "type": "ios-team:analytics" }, "model": "sonnet", "effort": "medium" },
    { "name": "engine marker in the route line", "match": { "regex": "route: auto — [^\\n]*движок" }, "tier": "deep" },
    { "name": "class S in the route line", "match": { "regex": "route: auto — класс S\\b" }, "tier": "mechanical" },
    { "name": "class M in the route line", "match": { "regex": "route: auto — класс M\\b" }, "tier": "ordinary" },
    { "name": "class L in the route line", "match": { "regex": "route: auto — класс L\\b" }, "tier": "risky" },
    { "name": "engineer without a class", "match": { "type": "ios-team:ios-engineer" }, "tier": "risky" },
    { "name": "architect", "match": { "type": "ios-team:architect" }, "tier": "risky" },
    { "default": true, "auto": true }
  ],
  "escalate": { "enabled": true, "after": { "error": 1, "check": 2 }, "window_min": 60 }
}
