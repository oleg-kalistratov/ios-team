#!/bin/bash
# Fake xcrun for hooks.test.sh: answers `simctl list devices -j` from ../simctl.json (or $FAKE_SIMCTL_JSON), appends every other
# call to $FAKE_XCRUN_LOG when set, otherwise ignores it.
[ "${1:-} ${2:-}" = "simctl list" ] && { cat "${FAKE_SIMCTL_JSON:-$(dirname "$0")/../simctl.json}"; exit 0; }
[ -n "${FAKE_XCRUN_LOG:-}" ] && echo "$*" >> "$FAKE_XCRUN_LOG"
exit 0
